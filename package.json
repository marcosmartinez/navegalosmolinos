{
  "name": "espiritu-del-lago-web",
  "version": "0.1.0",
  "private": true,
  "description": "Sitio web de Espíritu del Lago (SOYM S.A.) — navegalosmolinos.com",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "db:up": "docker compose up -d db",
    "ci": "pnpm typecheck && pnpm test && pnpm build",
    "vercel-build": "payload migrate && next build"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.94.0",
    "@payloadcms/email-resend": "3.94.0",
    "@payloadcms/next": "3.94.0",
    "@payloadcms/plugin-redirects": "3.94.0",
    "@payloadcms/plugin-seo": "3.94.0",
    "@payloadcms/richtext-lexical": "3.94.0",
    "@payloadcms/storage-vercel-blob": "3.94.0",
    "@payloadcms/translations": "3.94.0",
    "@payloadcms/ui": "3.94.0",
    "graphql": "^16.11.0",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "payload": "3.94.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "sass": "^1.89.0",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9.3",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
