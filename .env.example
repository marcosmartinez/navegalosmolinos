# ─────────────────────────────────────────────────────────────
# Espíritu del Lago — variables de entorno
# Copiar a .env.local para desarrollo. Nunca commitear valores reales.
# En Vercel: Settings → Environment Variables (Production / Preview).
# Detalle en docs/TECHNICAL-ARCHITECTURE.md §7
# ─────────────────────────────────────────────────────────────

# Base de datos (local: docker compose; producción: Neon)
DATABASE_URI=postgres://postgres:postgres@localhost:5432/espiritu_del_lago

# Secreto de Payload (mínimo 32 caracteres aleatorios: `openssl rand -hex 32`)
PAYLOAD_SECRET=

# URL pública del sitio
#   local:      http://localhost:3000
#   producción: https://navegalosmolinos.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Almacenamiento de medios (Vercel Blob). Vacío en local = disco local.
BLOB_READ_WRITE_TOKEN=

# Email transaccional (Resend)
RESEND_API_KEY=
EMAIL_FROM="Espíritu del Lago <hola@navegalosmolinos.com>"
NOTIFY_INQUIRIES_TO=

# Antispam (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analítica
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Secretos de operación
REVALIDATE_SECRET=
PREVIEW_SECRET=

# Monitoreo
SENTRY_DSN=

# Marcar los datos sin confirmar en el sitio (subrayado punteado en oro). "false" para ocultar la marca.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=true

# Reservas (futuro — etapa 3)
BOOKING_PROVIDER=contact
BOOKING_API_KEY=
BOOKING_WEBHOOK_SECRET=
